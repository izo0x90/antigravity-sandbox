# Default Antigravity Sandbox Development Environment Dockerfile
#
# This template defines the base runtimes for your sandbox environment.
# It is loaded by default from the agy-sandbox package directory.
#
# To copy this Dockerfile to your project root for full local customization, run:
#   agy-sandbox init --dockerfile
#
# Custom build arguments (ARGs) below are dynamically overridden via your 'agy.yaml'.

ARG BASE_IMAGE=agy-base:latest
FROM ${BASE_IMAGE}

# Define build arguments with default values of "none" (opt-in via build_args in agy.yaml)
ARG PYTHON_VERSION=none
ARG NODE_VERSION=none
ARG RUST_VERSION=none
ARG MOJO_VERSION=none
ARG APT_PACKAGES=""

# Set global environment variables so cargo, rustup, pixi, and mojo are accessible to all users
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PIXI_HOME=/usr/local/pixi \
    PATH=/usr/local/cargo/bin:/usr/local/pixi/bin:$PATH

# --- RUNTIME SETUP ---

# Install extra system packages if specified in build_args.APT_PACKAGES
RUN if [ -n "${APT_PACKAGES}" ]; then \
      apt-get update && apt-get install -y ${APT_PACKAGES} && \
      rm -rf /var/lib/apt/lists/* ; \
    fi

# Install Python (Only if explicitly requested in build_args.PYTHON_VERSION)
RUN if [ "${PYTHON_VERSION}" != "none" ]; then \
      uv python install ${PYTHON_VERSION} && \
      ln -sf $(uv python find ${PYTHON_VERSION}) /usr/local/bin/python && \
      ln -sf $(uv python find ${PYTHON_VERSION}) /usr/local/bin/python3 ; \
    fi

# Install Node.js (Only if explicitly requested in build_args.NODE_VERSION)
RUN if [ "${NODE_VERSION}" != "none" ]; then \
      curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - && \
      apt-get install -y nodejs && \
      rm -rf /var/lib/apt/lists/* ; \
    fi

# Install Rust toolchain (Only if explicitly requested in build_args.RUST_VERSION)
RUN if [ "${RUST_VERSION}" != "none" ]; then \
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal && \
      chmod -R a+w /usr/local/cargo /usr/local/rustup ; \
    fi

# Install Pixi and global Modular Mojo / MAX toolchain (Only if explicitly requested in build_args.MOJO_VERSION)
RUN if [ "${MOJO_VERSION}" != "none" ]; then \
      curl -fsSL https://pixi.sh/install.sh | PIXI_HOME=/usr/local/pixi sh && \
      chmod -R a+w /usr/local/pixi && \
      pixi global install --channel https://conda.modular.com/max-nightly --channel conda-forge mojo && \
      chmod -R a+w /usr/local/pixi ; \
    fi
