ARG BASE_IMAGE=agy-base:latest
FROM ${BASE_IMAGE}

# Google Antigravity: the engine under /opt and the `agy` CLI in the agent's
# ~/.local/bin. Config, network policy and (optionally) proxy credentials come
# from kits/agy/spec.yaml and kits/agy-proxy/spec.yaml.
RUN cd /opt && \
    curl -fsSLO https://storage.googleapis.com/antigravity-public/antigravity-hub/2.0.1-6566078776737792/linux-x64/Antigravity.tar.gz && \
    tar -xzf Antigravity.tar.gz && \
    rm Antigravity.tar.gz

USER agent
WORKDIR /home/agent
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash && \
    mkdir -p /home/agent/.gemini/antigravity-cli

# Switch back to root user context by default so downstream Dockerfiles compile cleanly
USER root
WORKDIR /
